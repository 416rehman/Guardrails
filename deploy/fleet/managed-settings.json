  "sandbox": {
    "allowUnsandboxedCommands": false,
    "enabled": true,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": [
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "docs.rs",
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "codeload.github.com"
      ],
      "strictAllowlist": true
    }
  },
  "strictKnownMarketplaces": [
    {
      "pathPattern": "(^|/)\\.agents/marketplace/?$",
      "source": "pathPattern"
    }
  ]
