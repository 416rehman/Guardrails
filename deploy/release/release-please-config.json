{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/712fcf01effd08d7b0e7b1fd3861f2cb388bc8d1/schemas/config.json",
  "release-type": "rust",
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore(release): release ${branch}",
  "pull-request-header": "Release pull request from release-please. It is squash-merged like any other pull request; release-please then creates the tags and GitHub releases, and the release workflow signs and attests the artefacts.",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "commit-search-depth": 2000,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false,
      "updateAllPackages": false
    }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "grdr",
      "package-name": "grdr-bundle",
      "version-file": "deploy/release/VERSION",
      "extra-files": [
        {
          "type": "generic",
          "path": "deploy/release/VERSION"
        }
      ]
    },
    "crates/grdr-compat": {},
    "crates/grdr-core": {},
    "crates/grdr-crypto": {},
    "crates/grdr-fastpath": {},
    "crates/grdr-fastpath-ffi": {},
    "crates/grdr-ffi": {},
    "crates/grdr-intel": {},
    "crates/grdr-llm-proto": {},
    "crates/grdr-mcp-proto": {},
    "crates/grdr-model": {},
    "crates/grdr-ports": {},
    "crates/grdr-ports-testkit": {},
    "crates/grdr-proto": {},
    "crates/grdr-review": {},
    "crates/grdr-schema": {},
    "crates/grdr-strings": {},
    "crates/grdr-wasm": {},
    "crates/grdr-wire": {},
    "programs/grdr": {
      "component": "grdr-cli",
      "package-name": "grdr"
    },
    "programs/grdr-server": {},
    "bpf/grdr-sensor-linux-bpf": {},
    "desktop/grdr-desktop": {},
    "deploy/helm/grdr-server": {
      "release-type": "helm",
      "component": "chart-grdr-server"
    },
    "deploy/helm/grdr-node-sensor": {
      "release-type": "helm",
      "component": "chart-grdr-node-sensor"
    },
    "deploy/terraform/aws": {
      "release-type": "terraform-module",
      "component": "tf-aws"
    },
    "deploy/terraform/gcp": {
      "release-type": "terraform-module",
      "component": "tf-gcp"
    },
    "deploy/terraform/azure": {
      "release-type": "terraform-module",
      "component": "tf-azure"
    }
  }
}
