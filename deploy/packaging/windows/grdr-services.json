{
  "schema": "grdr.windows.services.v1alpha1",
  "program_dir": "%ProgramFiles%\\Guardrails ADR",
  "data_dir": "C:\\ProgramData\\Guardrails\\data",
  "user_data_dir": "%LOCALAPPDATA%\\Guardrails\\data",
  "pipes": {
    "decide": "\\\\.\\pipe\\grdr-protected-decide",
    "local": "\\\\.\\pipe\\grdr-protected-local"
  },
  "wsl_plugin": {
    "name": "grdr-wsl",
    "dll_name": "grdr-wsl.dll",
    "registry_key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Lxss\\Plugins\\GuardrailsADR"
  },
  "services": [
    {
      "name": "grdr-daemon",
      "display_name": "Guardrails ADR Daemon",
      "binary": "grdr-daemon.exe",
      "args": ["--profile", "protected"],
      "account": "NT SERVICE\\grdr-daemon",
      "start_type": "auto",
      "sid_type": "restricted",
      "outbound_network": false
    }
  ],
  "child_workers": [
    {
      "name": "grdr-engine",
      "display_name": "Guardrails ADR Rule Engine",
      "binary": "grdr-engine.exe",
      "args": ["--device-id", "local-endpoint"],
      "transport": "inherited_stdio",
      "account": "NT SERVICE\\grdr-engine",
      "sid_type": "restricted",
      "outbound_network": false
    },
    {
      "name": "grdr-uplink",
      "display_name": "Guardrails ADR Fleet Uplink",
      "binary": "grdr-uplink.exe",
      "args": ["daemon-worker"],
      "transport": "inherited_stdio",
      "account": "NT SERVICE\\grdr-uplink",
      "sid_type": "restricted",
      "outbound_network": true
    },
    {
      "name": "grdr-proxy",
      "display_name": "Guardrails ADR Local Proxy",
      "binary": "grdr-proxy.exe",
      "args": ["--protected"],
      "transport": "on_demand",
      "account": "NT SERVICE\\grdr-proxy",
      "sid_type": "restricted",
      "outbound_network": true
    }
  ]
}
