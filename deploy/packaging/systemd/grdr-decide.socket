[Unit]
Description=Guardrails ADR Local Hook Decision Socket
PartOf=grdr-daemon.service

[Socket]
# Endpoint hooks from any local user connect here; daemon authenticates callers via SO_PEERCRED.
ListenStream=/run/guardrails/decide.sock
SocketUser=root
SocketGroup=root
SocketMode=0666
DirectoryMode=0755
Service=grdr-daemon.service

[Install]
WantedBy=sockets.target
