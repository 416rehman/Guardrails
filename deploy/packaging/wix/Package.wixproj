<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>GuardrailsADR</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <DefineConstants>ProductVersion=$(ProductVersion);BinDir=$(BinDir)</DefineConstants>
  </PropertyGroup>
</Project>
