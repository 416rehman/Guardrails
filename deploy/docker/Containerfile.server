# syntax=docker/dockerfile:1.7
# Multi-arch minimal server image (docs/design/24 section 6, D-58).
# Builder uses Debian Bookworm for static musl compilation; runtime uses scratch as UID 65532.

ARG RUST_IMAGE=docker.io/library/rust:1.99.1-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c
ARG NODE_IMAGE=docker.io/library/node:22-bookworm-slim@sha256:be979e5523c76fa4d5ca4ebd3099078f220aa47ec39c48ad5b5df9314debd6eb

FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS web-builder
WORKDIR /src/web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
COPY web/apps/console/package.json ./apps/console/
COPY web/packages/api/package.json ./packages/api/
COPY web/packages/i18n/package.json ./packages/i18n/
COPY web/packages/kit/package.json ./packages/kit/
COPY web/packages/tokens/package.json ./packages/tokens/
COPY web/packages/ui/package.json ./packages/ui/
COPY web/apps/operator/package.json ./apps/operator/
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY web/ ./
RUN pnpm run build

FROM ${RUST_IMAGE} AS rust-builder
ARG TARGETARCH
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      musl-tools \
      pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY programs ./programs
COPY proto ./proto
COPY brand ./brand
COPY interface ./interface
COPY schema ./schema
COPY bpf ./bpf

RUN case "${TARGETARCH}" in \
      amd64) MUSL_TARGET="x86_64-unknown-linux-musl" ;; \
      arm64) MUSL_TARGET="aarch64-unknown-linux-musl" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && rustup target add "${MUSL_TARGET}" \
    && cargo build --release --locked --target "${MUSL_TARGET}" -p grdr-server -p grdr \
    && mkdir -p \
         /rootfs/usr/local/bin \
         /rootfs/usr/libexec/grdr \
         /rootfs/usr/lib/grdr/engines \
         /rootfs/usr/share/grdr/web \
         /rootfs/etc/ssl/certs \
         /rootfs/var/lib/grdr \
         /rootfs/tmp \
    && install -m 0755 "target/${MUSL_TARGET}/release/grdr-server" /rootfs/usr/local/bin/grdr-server \
    && install -m 0755 "target/${MUSL_TARGET}/release/grdr" /rootfs/usr/local/bin/grdr \
    && cp /etc/ssl/certs/ca-certificates.crt /rootfs/etc/ssl/certs/ca-certificates.crt \
    && printf 'grdr:x:65532:65532:Guardrails ADR:/var/lib/grdr:/sbin/nologin\n' > /rootfs/etc/passwd \
    && printf 'grdr:x:65532:\n' > /rootfs/etc/group \
    && chown -R 65532:65532 /rootfs/var/lib/grdr \
    && chmod 0750 /rootfs/var/lib/grdr \
    && chmod 1777 /rootfs/tmp

COPY --from=web-builder /src/web/apps/console/dist /rootfs/usr/share/grdr/web

FROM scratch AS runtime
LABEL org.opencontainers.image.title="grdr-server" \
      org.opencontainers.image.description="Guardrails ADR server control plane, ingest, lake, and operator plane" \
      org.opencontainers.image.vendor="Loonaro" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/416rehman/Guardrails"

COPY --from=rust-builder /rootfs /

USER 65532:65532
EXPOSE 8787 44444 9090
VOLUME ["/var/lib/grdr"]

ENV GRDR_DATA_DIR=/var/lib/grdr \
    GRDR_WEB_DIR=/usr/share/grdr/web \
    GRDR_SERVER_BIND=0.0.0.0:8787 \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

ENTRYPOINT ["/usr/local/bin/grdr-server"]
CMD ["--bind", "0.0.0.0:8787", "--data-dir", "/var/lib/grdr", "--web-dir", "/usr/share/grdr/web"]
