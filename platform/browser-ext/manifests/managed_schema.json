{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Guardrails Browser Extension Managed Policy",
  "type": "object",
  "properties": {
    "organizationId": {
      "type": "string",
      "title": "Organization identifier"
    },
    "serverOrigin": {
      "type": "string",
      "title": "Control plane server origin"
    },
    "failClosedOnDegraded": {
      "type": "boolean",
      "title": "Block sensitive uploads when grdr.browser host is unreachable"
    },
    "blockAnonymousSessions": {
      "type": "boolean",
      "title": "Block unauthenticated consumer AI endpoints via DNR"
    },
    "tenantRestrictions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "appModes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["off", "watch", "ask", "block"]
      }
    }
  }
}
