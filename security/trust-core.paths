# Trust-core paths (D-63, ADR-0043): strictly runtime security boundaries and core security/CI policy gates.
# Routine dependency/tool pins (Cargo.toml, Cargo.lock, rust-toolchain.toml, supply-chain/build-tools.toml),
# lint/format configs, release manifests, and agent/doc markdown sit outside trust-core so CI verifies them cleanly.
# Each line is a git :(glob,icase) pathspec from the root, so ASCII case does not matter; `**/`
# matches zero or more folders, and a folder line `x/**` also matches `x` itself.
# .github/actions/tree-paths/trust_core_touched.py does the matching.

# eBPF programs
bpf/**

# Windows driver and platform shells
crates/grdr-driver-windows/**
platform/windows/**

# macOS Swift shell and system extensions
platform/macos/**

# Privileged core and approval helper
programs/grdr-daemon/**
crates/grdr-sandbox-engine/**
programs/grdr-approve/**

# IPC peer authentication
crates/grdr-wire/src/peer_auth.rs
crates/grdr-wire/src/peer_auth/**

# Pack verifier, updater, and cryptography
crates/grdr-update/**
programs/grdr-updater/**
crates/grdr-crypto/**

# Policy evaluator and fast path
crates/grdr-core/src/policy.rs
crates/grdr-core/src/policy/**
crates/grdr-fastpath/**
crates/grdr-core/src/compile/fastpath.rs
crates/grdr-core/src/compile/fastpath/**

# Tenant context and row-level security
crates/grdr-ports/src/tenant.rs
crates/grdr-ports/src/tenant/**
crates/grdr-rel-postgres/migrations/**

# FFI unsafe boundaries
crates/grdr-ffi/**
crates/grdr-fastpath-ffi/**

# Core security bounds, CI workflow definitions, and dependency licence/ban policies
limits.toml
security/trust-core.paths
security/breakers.toml
security/scorecard.toml
.github/workflows/**
supply-chain/licences.toml
supply-chain/do-not-read.toml
**/.cargo/**
**/.gitattributes
**/.gitmodules
# Build-time code: every build script, and the folder (`<dir>/**`) of each workspace package whose
# library target is a proc-macro, listed by the change that adds that target
**/build.rs
**/deny.toml
**/deny.*.toml
**/.deny.toml
**/.deny.exceptions.toml
**/.config/deny.toml
**/.config/deny.exceptions.toml
**/.cargo/deny.toml
**/.cargo/deny.exceptions.toml
