{
  "name": "grdr-web-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "dev": "vite --config apps/console/vite.config.ts",
    "dev:operator": "vite --config apps/operator/vite.config.ts",
    "build": "vite --config apps/console/vite.config.ts build && vite --config apps/operator/vite.config.ts build",
    "preview": "vite --config apps/console/vite.config.ts preview",
    "typecheck": "tsc --noEmit && tsc -p apps/console/tsconfig.json --noEmit && tsc -p apps/operator/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^26.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.12"
  }
}
