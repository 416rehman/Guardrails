    "bgRail": "#181816",
    "bgRecessed": "#1F1F1C",
    "bgHover": "#272723",
    "borderSubtle": "#2A2A26",
    "borderStrong": "#3D3D37",
    "inkPrimary": "#F4F4F0",
    "inkSecondary": "#A6A69E",
    "inkMuted": "#787871",
    "actionPrimaryBg": "#F4F4F0",
    "actionPrimaryInk": "#111111",
    "accentSignal": "#5B9BFF",
    "accentSoft": "rgba(91, 155, 255, 0.14)",
    "allow": "#4ADE80",
    "allowBg": "rgba(74, 222, 128, 0.13)",
    "watch": "#60A5FA",
    "watchBg": "rgba(96, 165, 250, 0.14)",
    "ask": "#FBBF24",
    "askBg": "rgba(251, 191, 36, 0.14)",
    "block": "#F87171",
    "blockBg": "rgba(248, 113, 113, 0.14)",
    "neutral": "#A6A69E",
    "neutralBg": "rgba(166, 166, 158, 0.14)",
    "operatorBg": "#292524",
    "operatorInk": "#FAFAF9",
    "operatorBadge": "#FBBF24"
