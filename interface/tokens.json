{
  "$schema": "https://design-tokens.github.io/format/v1",
  "meta": {
    "name": "Guardrails Studio",
    "version": "1.0.0",
    "spacingBasePx": 4,
    "spacingScale": [4, 8, 16, 32, 64]
  },
  "typography": {
    "sans": "\"DM Sans\", system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
    "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, monospace"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "pill": "9999px"
  },
  "light": {
    "bgCanvas": "#FFFFFF",
    "bgRail": "#F7F7F5",
    "bgRecessed": "#F3F3F0",
    "bgHover": "#ECECE7",
    "borderSubtle": "#E6E6E0",
    "borderStrong": "#CFCFC8",
    "inkPrimary": "#111111",
    "inkSecondary": "#52524E",
    "inkMuted": "#767670",
    "actionPrimaryBg": "#111111",
    "actionPrimaryInk": "#FFFFFF",
    "accentSignal": "#0F52BA",
    "accentSoft": "rgba(15, 82, 186, 0.08)",
    "allow": "#166534",
    "allowBg": "rgba(22, 101, 52, 0.09)",
    "watch": "#0F52BA",
    "watchBg": "rgba(15, 82, 186, 0.09)",
    "ask": "#B45309",
    "askBg": "rgba(180, 83, 9, 0.10)",
    "block": "#B91C1C",
    "blockBg": "rgba(185, 28, 28, 0.09)",
    "neutral": "#52524E",
    "neutralBg": "rgba(82, 82, 78, 0.09)",
    "operatorBg": "#1C1917",
    "operatorInk": "#FAFAF9",
