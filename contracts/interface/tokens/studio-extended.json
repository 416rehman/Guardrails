{
  "$schema": "https://design-tokens.github.io/format/v1",
  "fontImports": [
    "@fontsource/dm-sans/latin-400.css",
    "@fontsource/dm-sans/latin-500.css",
    "@fontsource/dm-sans/latin-600.css",
    "@fontsource/dm-sans/latin-700.css",
    "@fontsource/dm-sans/latin-ext-400.css",
    "@fontsource/dm-sans/latin-ext-500.css",
    "@fontsource/dm-sans/latin-ext-600.css",
    "@fontsource/dm-sans/latin-ext-700.css",
    "@fontsource/ibm-plex-mono/latin-400.css",
    "@fontsource/ibm-plex-mono/latin-500.css",
    "@fontsource/ibm-plex-mono/latin-ext-400.css",
    "@fontsource/ibm-plex-mono/latin-ext-500.css",
    "@fontsource/ibm-plex-mono/cyrillic-400.css",
    "@fontsource/ibm-plex-mono/cyrillic-500.css"
  ],
  "scripts": {
    "latn": {
      "fontSans": "\"DM Sans\", system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
      "minFontSizePx": 12,
      "lineHeightStep": 1.45,
      "allowItalic": true
    },
    "cyrl": {
      "fontSans": "\"DM Sans\", \"Noto Sans\", system-ui, sans-serif",
      "minFontSizePx": 12,
      "lineHeightStep": 1.45,
      "allowItalic": true
    },
    "arab": {
      "fontSans": "\"Noto Sans Arabic\", \"Geeza Pro\", \"Tahoma\", \"DM Sans\", sans-serif",
      "minFontSizePx": 14,
      "lineHeightStep": 1.65,
      "allowItalic": false
    },
    "jpan": {
      "fontSans": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic UI\", \"DM Sans\", sans-serif",
      "minFontSizePx": 12,
      "lineHeightStep": 1.65,
      "allowItalic": false
    }
  },
  "spacing": {
    "space-0-5": "2px",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "16px",
    "space-4": "32px",
    "space-5": "64px",
    "space-6": "128px"
  },
  "motion": {
    "quickMs": 140,
    "standardMs": 220,
    "emphasisMs": 320,
    "approvalArmDefaultMs": 1000,
    "approvalArmIrreversibleMs": 2000
  },
  "light": {
    "bgSurface": "{light.bgCanvas}",
    "bgElevated": "{light.bgCanvas}",
    "backdropScrim": "rgba(15, 23, 42, 0.42)",
    "shadowOverlay": "0 16px 40px rgba(15, 23, 42, 0.12)",
    "pressTint": "rgba(255, 255, 255, 0.24)",
    "toneAllowBorder": "rgba(21, 128, 61, 0.20)",
    "toneWatchBorder": "rgba(29, 78, 216, 0.20)",
    "toneAskBorder": "rgba(202, 138, 4, 0.34)",
    "attentionSurfaceGradient": "linear-gradient(90deg, rgba(239, 68, 68, 0.11) 0%, rgba(239, 68, 68, 0.045) 32%, rgba(239, 68, 68, 0.01) 62%, rgba(239, 68, 68, 0) 88%)",
    "attentionSurfaceBorder": "rgba(239, 68, 68, 0.24)",
    "toneBlockBorder": "rgba(185, 28, 28, 0.22)",
    "toneNeutralBorder": "rgba(71, 85, 105, 0.16)",
    "vizAllowGlow": "rgba(59, 130, 246, 0.18)",
    "vizWatchGlow": "rgba(37, 99, 235, 0.18)",
    "vizAskGlow": "rgba(234, 179, 8, 0.18)",
    "vizBlockGlow": "rgba(239, 68, 68, 0.18)",
    "vizGridLine": "rgba(15, 23, 42, 0.06)",
    "vizRailTrack": "rgba(15, 23, 42, 0.03)",
    "vizDialTick": "rgba(15, 23, 42, 0.16)",
    "vizHexEmpty": "rgba(15, 23, 42, 0.025)",
    "vizHexEmptyStroke": "rgba(15, 23, 42, 0.10)",
    "surfaceSpecular": "rgba(255, 255, 255, 0.85)",
    "surfaceElevatedShadow": "0 1px 2px rgba(15, 23, 42, 0.04)",
    "heroGlassBg": "rgba(255, 255, 255, 0.78)",
    "heroGlassBorder": "rgba(15, 23, 42, 0.08)",
    "heroCardBg": "rgba(255, 255, 255, 0.92)",
    "heroCardShadow": "0 14px 36px rgba(37, 99, 235, 0.10), 0 2px 8px rgba(15, 23, 42, 0.05)",
    "operatorBadgeInk": "{light.operatorBg}",
    "focusRing": "0 0 0 2px {light.bgCanvas}, 0 0 0 4px {light.accentSignal}"
  },
  "dark": {
    "bgSurface": "#12161C",
    "bgElevated": "{dark.operatorBg}",
    "backdropScrim": "rgba(0, 0, 0, 0.65)",
    "shadowOverlay": "0 20px 48px rgba(0, 0, 0, 0.55)",
    "pressTint": "rgba(255, 255, 255, 0.16)",
    "toneAllowBorder": "rgba(52, 211, 153, 0.22)",
    "toneWatchBorder": "rgba(96, 165, 250, 0.22)",
    "toneAskBorder": "rgba(250, 204, 21, 0.28)",
    "attentionSurfaceGradient": "linear-gradient(90deg, rgba(239, 68, 68, 0.17) 0%, rgba(239, 68, 68, 0.07) 32%, rgba(239, 68, 68, 0.015) 64%, rgba(239, 68, 68, 0) 90%)",
    "attentionSurfaceBorder": "rgba(248, 113, 113, 0.26)",
    "toneBlockBorder": "rgba(248, 113, 113, 0.22)",
    "toneNeutralBorder": "rgba(148, 163, 184, 0.20)",
    "vizAllowGlow": "rgba(59, 130, 246, 0.22)",
    "vizWatchGlow": "rgba(59, 130, 246, 0.22)",
    "vizAskGlow": "rgba(250, 204, 21, 0.20)",
    "vizBlockGlow": "rgba(239, 68, 68, 0.22)",
    "vizGridLine": "rgba(241, 245, 249, 0.06)",
    "vizRailTrack": "rgba(241, 245, 249, 0.04)",
    "vizDialTick": "rgba(241, 245, 249, 0.16)",
    "vizHexEmpty": "rgba(241, 245, 249, 0.02)",
    "vizHexEmptyStroke": "rgba(241, 245, 249, 0.10)",
    "surfaceSpecular": "rgba(255, 255, 255, 0.05)",
    "surfaceElevatedShadow": "0 1px 2px rgba(0, 0, 0, 0.32)",
    "heroGlassBg": "rgba(18, 22, 28, 0.72)",
    "heroGlassBorder": "rgba(241, 245, 249, 0.10)",
    "heroCardBg": "rgba(18, 22, 28, 0.88)",
    "heroCardShadow": "0 18px 44px rgba(0, 0, 0, 0.48), 0 2px 10px rgba(59, 130, 246, 0.10)",
    "operatorBadgeInk": "{dark.bgCanvas}",
    "focusRing": "0 0 0 2px {dark.bgCanvas}, 0 0 0 4px {dark.accentSignal}"
  }
}
