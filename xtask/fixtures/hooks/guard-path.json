{
  "handler": "guard-path",
  "preset": "worker",
  "cases": [
    {"name": "protected-path-via-dotdot", "env": {"GRDR_AGENT": "impl-rust", "GRDR_WORK_ITEM": "7"},
     "input": {"tool_name": "Edit", "tool_input": {"file_path": "crates/a/src/../../../Cargo.toml"}}, "expect": "block", "contains": "protected"},
    {"name": "outside-write-set", "env": {"GRDR_AGENT": "impl-rust", "GRDR_WORK_ITEM": "7"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": "programs/grdr/src/main.rs"}}, "expect": "block", "contains": "write set"},
    {"name": "kit-state-denied", "env": {"GRDR_AGENT": "impl-rust", "GRDR_WORK_ITEM": "7"},
     "input": {"tool_name": "Edit", "tool_input": {"file_path": ".agent/state/item-7.json"}}, "expect": "block", "contains": "kit"},
    {"name": "handoff-draft-allowed", "env": {"GRDR_AGENT": "impl-rust", "GRDR_WORK_ITEM": "7"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": ".agent/state/handoff-7.json"}}, "expect": "approve"},
    {"name": "no-snapshot-normal-path", "preset": "no-snapshot", "env": {"GRDR_AGENT": "impl-rust", "GRDR_WORK_ITEM": "7"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": "crates/a/src/new.rs"}}, "expect": "approve"},
    {"name": "no-snapshot-protected-path", "preset": "no-snapshot", "env": {"GRDR_AGENT": "impl-rust", "GRDR_WORK_ITEM": "7"},
     "input": {"tool_name": "Edit", "tool_input": {"file_path": "limits.toml"}}, "expect": "block", "contains": "protected"},
    {"name": "seed-scope-places-agents-md", "preset": "architect-seed", "env": {"GRDR_AGENT": "chief-architect", "GRDR_SCOPE": "seed"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": "AGENTS.md"}}, "expect": "block", "contains": "kit place --stage AGENTS.md"},
    {"name": "seed-scope-still-denies-others", "preset": "architect-seed", "env": {"GRDR_AGENT": "chief-architect", "GRDR_SCOPE": "seed"},
     "input": {"tool_name": "Edit", "tool_input": {"file_path": "limits.toml"}}, "expect": "block", "contains": "protected"},
    {"name": "no-snapshot-outside-roster-write", "preset": "no-snapshot", "env": {"GRDR_AGENT": "impl-rust", "GRDR_WORK_ITEM": "7"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": "programs/grdr/src/main.rs"}}, "expect": "block", "contains": "outside what impl-rust writes"},
    {"name": "architect-writes-no-code", "preset": "no-snapshot", "env": {"GRDR_AGENT": "chief-architect"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": "crates/a/src/lib.rs"}}, "expect": "block", "contains": "outside what chief-architect writes"},
    {"name": "seed-writes-only-seed-paths", "preset": "architect-seed", "env": {"GRDR_AGENT": "chief-architect", "GRDR_SCOPE": "seed"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": "crates/a/src/lib.rs"}}, "expect": "block", "contains": "seed scope"},
    {"name": "protected-scope-needs-a-protected-agent", "env": {"GRDR_AGENT": "impl-rust", "GRDR_WORK_ITEM": "7", "GRDR_SCOPE": "protected"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": ".agents/kit/hooks.toml"}}, "expect": "block", "contains": "protected"},
    {"name": "protected-lease-places-its-write-set", "preset": "protected", "env": {"GRDR_AGENT": "lead-agent-kit", "GRDR_WORK_ITEM": "7", "GRDR_SCOPE": "protected"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": ".agents/kit/hooks.toml"}}, "expect": "block", "contains": "cargo xtask kit place .agents/kit/hooks.toml"},
    {"name": "protected-lease-stages-its-write-set", "preset": "protected", "env": {"GRDR_AGENT": "lead-agent-kit", "GRDR_WORK_ITEM": "7", "GRDR_SCOPE": "protected"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": ".agent/state/place/.agents/kit/hooks.toml.staged"}}, "expect": "approve"},
    {"name": "person-write-is-no-approval", "preset": "no-snapshot", "env": {},
     "input": {"tool_name": "Write", "tool_input": {"file_path": "crates/a/src/new.rs"}}, "expect": "allow"},
    {"name": "agent-outside-the-repository-is-no-approval", "preset": "no-snapshot", "env": {"GRDR_AGENT": "impl-rust"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": "/tmp/grdr-selftest-notes.txt"}}, "expect": "allow"},
    {"name": "home-claude-settings", "preset": "no-snapshot", "env": {"GRDR_AGENT": "impl-rust", "HOME": "/home/someone", "USERPROFILE": "/home/someone"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": "~/.claude/settings.json"}}, "expect": "block", "contains": "configures every later session"},
    {"name": "home-gh-config-named", "preset": "no-snapshot", "env": {"GRDR_AGENT": "impl-rust", "HOME": "/home/someone", "USERPROFILE": "/home/someone"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": "~/.config/gh/hosts.yml"}}, "expect": "block", "contains": "gh's configuration directory"},
    {"name": "claude-config-dir-settings", "preset": "no-snapshot", "env": {"GRDR_AGENT": "impl-rust", "CLAUDE_CONFIG_DIR": "/cfg/claude"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": "/cfg/claude/settings.json"}}, "expect": "block", "contains": "configures every later session"},
    {"name": "gh-config-in-app-data", "preset": "no-snapshot", "env": {"GRDR_AGENT": "impl-rust", "APPDATA": "C:\\Users\\dev\\AppData\\Roaming"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": "C:/Users/dev/AppData/Roaming/GitHub CLI/hosts.yml"}}, "expect": "block", "contains": "configures every later session"},
    {"name": "gh-config-dir-variable", "preset": "no-snapshot", "env": {"GRDR_AGENT": "impl-rust", "GH_CONFIG_DIR": "/cfg/gh"},
     "input": {"tool_name": "Write", "tool_input": {"file_path": "/cfg/gh/hosts.yml"}}, "expect": "block", "contains": "configures every later session"}
  ]
}
