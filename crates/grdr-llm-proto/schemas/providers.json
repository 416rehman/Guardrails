{
  "schema_version": 1,
  "limits": {
    "max_request_bytes": 33554432,
    "max_sse_event_bytes": 1048576,
    "max_json_depth": 64,
    "max_tool_calls": 1024,
    "max_decompression_ratio": 100
  },
  "providers": [
    {
      "id": "anthropic_messages",
      "family": "anthropic_messages",
      "host_patterns": ["api.anthropic.com"],
      "path_prefixes": ["/v1/messages"],
      "model_keys": ["model"],
      "stream_keys": ["stream"],
      "system_keys": ["system"],
      "message_array_keys": ["messages"],
      "tool_array_keys": ["tools"],
      "tool_name_paths": ["name"],
      "response_stop_keys": ["stop_reason"],
      "response_usage_keys": ["usage", "input_tokens", "output_tokens"],
      "requires_sigv4": false
    },
    {
      "id": "openai_chat",
      "family": "openai_chat",
      "host_patterns": ["api.openai.com", ".openai.azure.com"],
      "path_prefixes": ["/v1/chat/completions", "/openai/deployments/"],
      "model_keys": ["model"],
      "stream_keys": ["stream"],
      "system_keys": [],
      "message_array_keys": ["messages"],
      "tool_array_keys": ["tools", "functions"],
      "tool_name_paths": ["function.name", "name"],
      "response_stop_keys": ["finish_reason"],
      "response_usage_keys": ["usage", "prompt_tokens", "completion_tokens"],
      "requires_sigv4": false
    },
    {
      "id": "openai_responses",
      "family": "openai_responses",
      "host_patterns": ["api.openai.com"],
      "path_prefixes": ["/v1/responses"],
      "model_keys": ["model"],
      "stream_keys": ["stream"],
      "system_keys": ["instructions"],
      "message_array_keys": ["input"],
      "tool_array_keys": ["tools"],
      "tool_name_paths": ["name", "function.name", "type"],
      "response_stop_keys": ["status"],
      "response_usage_keys": ["usage", "input_tokens", "output_tokens"],
      "requires_sigv4": false
    },
    {
      "id": "google_gemini",
      "family": "google_gemini",
      "host_patterns": ["generativelanguage.googleapis.com", "-aiplatform.googleapis.com"],
      "path_prefixes": ["/v1/models/", "/v1beta/models/", "/v1/projects/"],
      "model_keys": ["model"],
      "stream_keys": [],
      "system_keys": ["systemInstruction", "system_instruction"],
      "message_array_keys": ["contents"],
      "tool_array_keys": ["tools"],
      "tool_name_paths": ["functionDeclarations[*].name"],
      "response_stop_keys": ["finishReason"],
      "response_usage_keys": ["usageMetadata", "promptTokenCount", "candidatesTokenCount"],
      "requires_sigv4": false
    },
    {
      "id": "aws_bedrock",
      "family": "aws_bedrock",
      "host_patterns": [".amazonaws.com"],
      "path_prefixes": ["/model/"],
      "model_keys": ["modelId"],
      "stream_keys": [],
      "system_keys": ["system"],
      "message_array_keys": ["messages"],
      "tool_array_keys": ["toolConfig.tools"],
      "tool_name_paths": ["toolSpec.name", "name"],
      "response_stop_keys": ["stopReason", "stop_reason"],
      "response_usage_keys": ["usage", "inputTokens", "outputTokens"],
      "requires_sigv4": true
    },
    {
      "id": "openai_realtime",
      "family": "openai_realtime",
      "host_patterns": ["api.openai.com"],
      "path_prefixes": ["/v1/realtime"],
      "model_keys": ["model"],
      "stream_keys": [],
      "system_keys": ["instructions"],
      "message_array_keys": ["item", "items"],
      "tool_array_keys": ["tools"],
      "tool_name_paths": ["name"],
      "response_stop_keys": ["status"],
      "response_usage_keys": ["usage", "input_tokens", "output_tokens"],
      "requires_sigv4": false
    },
    {
      "id": "a2a",
      "family": "a2a",
      "host_patterns": [],
      "path_prefixes": ["/.well-known/agent-card.json", "/.well-known/agent.json", "/v1/message:", "/v1/tasks"],
      "model_keys": [],
      "stream_keys": [],
      "system_keys": [],
      "message_array_keys": ["parts"],
      "tool_array_keys": ["skills"],
      "tool_name_paths": ["id", "name"],
      "response_stop_keys": ["state"],
      "response_usage_keys": [],
      "requires_sigv4": false
    }
  ]
}
