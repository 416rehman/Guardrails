{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoMemoryEnabled": false,
  "availableModels": [
    "claude-opus-5-5",
    "claude-sonnet-5-5",
    "claude-fable-5-2"
  ],
  "disableAutoMode": "disable",
  "enabledPlugins": {
    "agentic-actions-auditor@grdr-agent-marketplace": true,
    "ce-simplify-code@grdr-agent-marketplace": true,
    "cleanup@grdr-agent-marketplace": true,
    "code-simplifier@grdr-agent-marketplace": true,
    "differential-review@grdr-agent-marketplace": true,
    "dzhng-skills@grdr-agent-marketplace": true,
    "fp-check@grdr-agent-marketplace": true,
    "frontend-design@grdr-agent-marketplace": true,
    "hookify@grdr-agent-marketplace": true,
    "insecure-defaults@grdr-agent-marketplace": true,
    "md-management@grdr-agent-marketplace": true,
    "modern-web-guidance@grdr-agent-marketplace": true,
    "mutation-testing@grdr-agent-marketplace": true,
    "patching-bugs@grdr-agent-marketplace": true,
    "pr-review-toolkit@grdr-agent-marketplace": true,
    "property-based-testing@grdr-agent-marketplace": true,
    "regression-hunt@grdr-agent-marketplace": true,
    "rust-analyzer-lsp@grdr-agent-marketplace": true,
    "rust-review@grdr-agent-marketplace": true,
    "security-guidance@grdr-agent-marketplace": true,
    "security-scan@grdr-agent-marketplace": true,
    "semgrep@grdr-agent-marketplace": true,
    "sharp-edges@grdr-agent-marketplace": true,
    "spec-to-code-compliance@grdr-agent-marketplace": true,
    "superpowers@grdr-agent-marketplace": true,
    "supply-chain-risk-auditor@grdr-agent-marketplace": true,
    "thermo-nuclear-code-quality-review@grdr-agent-marketplace": true,
    "typescript-lsp@grdr-agent-marketplace": true,
    "unslop@grdr-agent-marketplace": true,
    "writing-lean-proofs@grdr-agent-marketplace": true
  },
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-5-5",
    "CARGO_TERM_COLOR": "never",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "3",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_CODE_SECURITY_REVIEW": "0",
    "GH_NO_UPDATE_NOTIFIER": "1",
    "GH_PROMPT_DISABLED": "1",
    "GH_REPO": "416rehman/Guardrails",
    "GRDR_KIT": "1",
    "SEMGREP_GUARDIAN_AUTO_UPDATE": "0"
  },
  "extraKnownMarketplaces": {
    "grdr-agent-marketplace": {
      "source": {
        "path": "./.agents/marketplace",
        "source": "directory"
      }
    }
  },
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook config-change",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook post-edit",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook post-bash",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook pre-compact",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook model-switch",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook guard-path",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook guard-command",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook session-end",
            "timeout": 2,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook session-start",
            "timeout": 300,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|fork"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook session-restore",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook stop-gate",
            "timeout": 600,
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook stop-failure",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook subagent-start",
            "timeout": 20,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook subagent-stop",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.agent/kit/bin/xtask\" hook model-gate",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "claude-sonnet-5-5",
