    "defaultMode": "bypassPermissions",
    "deny": []
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "enabled": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh"
      ]
    },
    "network": {
      "allowedDomains": [
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "docs.rs",
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
