{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoMemoryEnabled": false,
  "availableModels": [
    "claude-opus-5-5",
    "claude-sonnet-5-5",
    "claude-fable-5-2"
  ],
  "disableAutoMode": "disable",
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-5-5",
    "CARGO_TERM_COLOR": "never",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_CODE_SECURITY_REVIEW": "0",
    "GH_NO_UPDATE_NOTIFIER": "1",
    "GH_PROMPT_DISABLED": "1",
    "GH_REPO": "416rehman/Guardrails",
    "SEMGREP_GUARDIAN_AUTO_UPDATE": "0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/docs-check.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/permission-allow.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "model": "claude-sonnet-5-5",
  "permissions": {
    "allow": [
      "Bash(cargo check *)",
      "Bash(cargo build *)",
      "Bash(cargo nextest *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(pnpm run *)",
      "Bash(pnpm -r run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh search issues *)",
      "Bash(gh label list *)",
      "Bash(gh repo view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(git checkout HEAD -- *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(cargo update *)",
      "Bash(cargo metadata *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh workflow run verify.yml --ref issue/*)",
      "Bash(gh workflow run lab.yml --ref issue/*)",
      "Bash(gh run download *)",
      "Bash(gh run watch *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git rev-parse *)",
      "Bash(git branch *)",
      "Bash(buf lint *)",
      "Bash(buf breaking *)",
      "Bash(cargo semver-checks *)",
      "Bash(cargo deny check)",
      "Bash(cargo deny check *)",
      "Bash(cargo vet --locked)",
      "Bash(cargo vet --locked check *)",
      "Bash(pnpm licenses list *)",
      "Bash(cargo mutants *)",
      "Bash(pnpm install --frozen-lockfile *)",
      "Bash(gh api --method POST repos/416rehman/Guardrails/check-runs *)",
      "Bash(gh api --method PATCH repos/416rehman/Guardrails/check-runs/*)",
      "Bash(gh api --method POST repos/416rehman/Guardrails/statuses/*)",
      "Write(./target/**)",
      "Edit(./target/**)",
      "mcp__playwright__*",
      "WebFetch(domain:www.1password.dev)",
      "WebFetch(domain:support.1password.com)",
