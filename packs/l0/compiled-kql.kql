// Guardrails ADR L0 KQL Export (Defender DeviceId containment join enabled)
DeviceProcessEvents | where ((ProcessCommandLine contains '-EncodedCommand' or ProcessCommandLine contains 'base64 -d' or ProcessCommandLine contains 'FromBase64String') and (InitiatingProcessFileName endswith 'claude' or InitiatingProcessFileName endswith 'codex' or InitiatingProcessFileName endswith 'cursor' or InitiatingProcessFileName endswith 'gemini' or InitiatingProcessFileName endswith 'opencode' or InitiatingProcessFileName endswith 'aider')) | project Timestamp, DeviceId, DeviceName, ActionType
